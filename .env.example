# 复制为 .env 后填写。不要提交 .env。

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# openai：官方或 OpenAI 兼容网关（需同时填 OPENAI_BASE_URL）
# deepseek：DeepSeek 官方
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=0.7

OPENAI_API_KEY=
OPENAI_BASE_URL=

DEEPSEEK_API_KEY=

# 主模型失败后的备用供应商。留空则跳过，直接角色口吻降级。
# LLM_FALLBACK_PROVIDER=deepseek
# LLM_FALLBACK_MODEL=deepseek-chat

# 本地默认 SQLite。上 Postgres：postgresql+asyncpg://user:pass@host:5432/companion
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
CORS_ORIGINS=*

# 短期上下文送进模型的对话轮数（全量消息仍落库）
SHORT_TERM_TURN_LIMIT=16

# 观测：默认关闭。开启后每轮对话会进入 LangSmith 指定项目（含会话/角色/request_id）。
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=companion

# 评测集权威来源是仓库 JSON。有 Key 后可同步：python -m app.eval --sync
