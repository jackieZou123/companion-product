# 复制为 .env 后填写。不要提交 .env。

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# openai：OpenAI 兼容网关。TeamoRouter 必须带 /v1
# deepseek：DeepSeek 官方直连（不走 TeamoRouter）
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=0.7

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.teamorouter.cn/v1

DEEPSEEK_API_KEY=

# 主模型失败后的备用供应商。留空则跳过，直接角色口吻降级。
# LLM_FALLBACK_PROVIDER=deepseek
# LLM_FALLBACK_MODEL=deepseek-chat

# 本地默认 SQLite。上 Postgres：postgresql+asyncpg://user:pass@host:5432/companion
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# TeamoRouter 大模型首字可能较慢，流式对话建议不要短于 120
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
CORS_ORIGINS=*

# 会话接口必须带 X-User-Id。成年校验由接入方账号体系负责，不在创建会话时自报。

# 短期上下文送进模型的对话轮数（全量消息仍落库）
SHORT_TERM_TURN_LIMIT=16

# 观测：默认关闭。开启后每轮对话会进入 LangSmith 指定项目（含会话/角色/request_id）。
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=companion

# 评测集权威来源是仓库 JSON。默认 Stub：python -m app.eval
# 真模型：python -m app.eval --live
# 同步到 LangSmith：python -m app.eval --sync

# 主动消息：闲置满 N 小时才回访；24 小时最多一条；未取超过 TTL 失效
# NUDGE_IDLE_HOURS=24
# NUDGE_RATE_HOURS=24
# NUDGE_TTL_HOURS=48
